# GitHub API, read-only. Powers the repo list, the totals and the contribution
# calendar. A classic token with no scopes is enough; without it the site still
# renders, those sections just come back empty.
GITHUB_TOKEN=

# GitHub OAuth app, for signing the guestbook.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where the contact form delivers.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NextAuth. Generate the secret with: openssl rand -base64 32
NEXT_AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Guestbook storage.
MONGODB_URI=
